        "# Heatmap\n",
        "\n",
        "def plot_gdp_heatmap(df, year_col='Year', country_col='Country', gdp_col='GDP (USD)', alliance_col='Alliances'):\n",
        "    pivot_df = df.pivot(index=country_col, columns=year_col, values=gdp_col)\n",
        "\n",
        "    fig = px.imshow(\n",
        "        pivot_df,\n",
        "        labels=dict(x=\"Year\", y=\"Country\", color=\"GDP (USD)\"),\n",
        "        color_continuous_scale=\"mint\",\n",
        "        title=\"GDP by Country and Year\",\n",
        "    )\n",
        "\n",
        "    fig.update_layout(\n",
        "        height=700,\n",
        "        width=1200,\n",
        "        title_x=0.5,\n",
        "        title_xanchor='center'\n",
        "    )\n",
        "    fig.show()\n",
        "\n",
        "plot_gdp_heatmap(df)\n"
