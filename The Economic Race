        "def group_countries_by_alliance(df, alliance='Alliances', country='Country'):\n",
        "    # Group by the alliance column and get unique countries\n",
        "    grouped = df.groupby(alliance)[country].unique()\n",
        "    return grouped.to_dict()\n",
        "\n",
        "# Call the function\n",
        "alliance_groups = group_countries_by_alliance(df)\n",
