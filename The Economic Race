        "# Bubble Chart\n",
        "\n",
        "def plot_gdp_bubble_chart(df, year_col='Year', country_col='Country', gdp_col='GDP (USD)', alliance_col='Alliances'):\n",
        "    # Create a bubble chart using GDP as the size of the bubbles\n",
        "    fig = px.scatter(\n",
        "        df,\n",
        "        x=year_col,\n",
        "        y=country_col,\n",
        "        size=gdp_col,\n",
        "        color=alliance_col,\n",
        "        hover_name=country_col,\n",
        "        size_max=55,\n",
        "        labels={year_col: \"Year\", country_col: \"Country\", gdp_col: \"GDP (USD)\"},\n",
        "        title=\"GDP by Country and Year\",\n",
        "    )\n",
        "    fig.update_layout(\n",
        "        height=700,\n",
        "        width=1200,\n",
        "        title_x=0.5,\n",
        "        title_xanchor='center'\n",
        "    )\n",
        "\n",
        "    fig.show()\n",
        "\n",
        "plot_gdp_bubble_chart(df)\n"
      ],
