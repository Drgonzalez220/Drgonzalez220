      "source": [
        "def plot_gdp_sum_by_alliance(df, alliance_groups, year_col='Year', alliance_col='Alliances', gdp_col='GDP (USD)'):\n",
        "    # Filter the DataFrame to include only rows corresponding to alliances in alliance_groups\n",
        "    filtered_df = df[df[alliance_col].isin(alliance_groups.keys())]\n",
        "\n",
        "    # Group by year and alliance, summing the GDP\n",
        "    grouped = filtered_df.groupby([year_col, alliance_col])[gdp_col].sum().reset_index()\n",
        "\n",
        "    # Pivot the data for easier plotting\n",
        "    pivot_df = grouped.pivot(index=year_col, columns=alliance_col, values=gdp_col).reset_index()\n",
        "\n",
        "    # Create a bar chart using Plotly Graph Objects\n",
        "    fig = go.Figure()\n",
        "\n",
        "    # Add bars for each alliance in the pivoted data\n",
        "    for alliance in pivot_df.columns[1:]:\n",
        "        fig.add_trace(go.Bar(\n",
        "            x=pivot_df[year_col],\n",
        "            y=pivot_df[alliance],\n",
        "            name=f\"{alliance} GDP\"\n",
        "        ))\n",
        "\n",
        "    # Customize layout\n",
        "    fig.update_layout(\n",
        "        title='GDP Growth (2000–2023)',\n",
        "        title_x=0.5,\n",
        "        title_xanchor='center',\n",
        "        xaxis=dict(title='Year'),\n",
        "        yaxis=dict(title='Total GDP (USD)'),\n",
        "        barmode='group',\n",
        "        legend_title='Alliances',\n",
        "        template='plotly_white',\n",
        "        height=700,\n",
        "        width=1200\n",
        "    )\n",
        "    fig.show()\n",
        "\n",
        "plot_gdp_sum_by_alliance(df, alliance_groups)\n"
      ]
    },
