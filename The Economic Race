        "def plot_gdp_comparison_by_year(df, selected_year, year_col='Year', alliance_col='Alliances', gdp_col='GDP (USD)'):\n",
        "    # Filter data for the selected year\n",
        "    filtered_df = df[df[year_col] == selected_year]\n",
        "\n",
        "    # Group by alliances and sum the GDP\n",
        "    gdp_by_alliance = filtered_df.groupby(alliance_col)[gdp_col].sum().reset_index()\n",
        "\n",
        "    # Create the bar chart\n",
        "    fig = go.Figure()\n",
        "\n",
        "    # Add bars for G7 and BRICS\n",
        "    for _, row in gdp_by_alliance.iterrows():\n",
        "        fig.add_trace(go.Bar(\n",
        "            x=[row[alliance_col]],\n",
        "            y=[row[gdp_col]],\n",
        "            name=row[alliance_col]\n",
        "        ))\n",
        "\n",
        "    # Customize layout\n",
        "    fig.update_layout(\n",
        "        title=f'GDP Comparison in {selected_year}',\n",
        "        title_x=0.5,\n",
        "        xaxis=dict(title='Alliance'),\n",
        "        yaxis=dict(title='Total GDP (USD)'),\n",
        "        template='plotly_white',\n",
        "        height=600,\n",
        "        width=800\n",
        "    )\n",
        "\n",
        "    # Show the plot\n",
        "    fig.show()\n",
        "\n",
        "plot_gdp_comparison_by_year(df, 2001)\n"
      ]
    },
