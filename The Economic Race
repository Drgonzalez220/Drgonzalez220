        "def plot_country_count_by_alliance(alliance_groups):\n",
        "    # Count the number of countries in G7 and BRICS\n",
        "    g7_count = len(alliance_groups.get('G7', []))\n",
        "    brics_count = len(alliance_groups.get('BRICS', []))\n",
        "\n",
        "    # Create a bar chart using Plotly Graph Objects\n",
        "    fig = go.Figure()\n",
        "\n",
        "    # Add bars for G7 and BRICS\n",
        "\n",
        "    fig.add_trace(go.Bar(\n",
        "        x=['BRICS'],\n",
        "        y=[brics_count],\n",
        "        name='BRICS'\n",
        "    ))\n",
        "\n",
        "    fig.add_trace(go.Bar(\n",
        "        x=['G7'],\n",
        "        y=[g7_count],\n",
        "        name='G7'\n",
        "    ))\n",
        "    # Customize layout\n",
        "    fig.update_layout(\n",
        "        title='Country Count by Alliance',\n",
        "        title_x=0.5,\n",
        "        title_xanchor='center',\n",
        "        xaxis=dict(title='Alliance'),\n",
        "        yaxis=dict(title='Number of Countries'),\n",
        "        template='plotly_white',\n",
        "        height=600,\n",
        "        width=800\n",
        "    )\n",
        "    fig.show()\n",
        "\n",
        "plot_country_count_by_alliance(alliance_groups)"
      ]
    },
