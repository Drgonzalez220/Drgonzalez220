      "source": [
        "def plot_gdp_by_country(df, year, year_col='Year', country_col='Country', gdp_col='GDP (USD)', alliance_col='Alliances'):\n",
        "    filtered_df = df[df[year_col] == year]\n",
        "\n",
        "    # Sort countries by GDP in descending order\n",
        "    sorted_df = filtered_df.sort_values(by=gdp_col, ascending=False)\n",
        "\n",
        "    # Assign colors based on the Alliances column directly\n",
        "    colors = sorted_df[alliance_col].map({'G7': 'red', 'BRICS': 'blue'})\n",
        "\n",
        "    # Create a bar chart\n",
        "    fig = go.Figure()\n",
        "\n",
        "    fig.add_trace(go.Bar(\n",
        "        x=sorted_df[gdp_col],\n",
        "        y=sorted_df[country_col],\n",
        "        orientation='h',\n",
        "        name=f\"GDP Rankings ({year})\",\n",
        "        marker=dict(color=colors)\n",
        "    ))\n",
        "\n",
        "    # Customize the layout\n",
        "    fig.update_layout(\n",
        "        title=f\"GDP Rankings in {year}\",\n",
        "        title_x=0.5,\n",
        "        xaxis=dict(title='GDP (USD)'),\n",
        "        yaxis=dict(title='Country', categoryorder='total ascending'),\n",
        "        template='plotly_white',\n",
        "        height=700,\n",
        "        width=1200\n",
        "    )\n",
        "\n",
        "    fig.show()\n",
        "\n",
        "# Example usage\n",
        "plot_gdp_by_country(df, year=2000)\n"
      ]
    },
