        "# Heatmap for US and China\n",
        "\n",
        "def plot_gdp_heatmap_us_china(df, year_col='Year', country_col='Country', gdp_col='GDP (USD)'):\n",
        "    filtered_df = df[df[country_col].isin(['United States', 'China'])]\n",
        "\n",
        "    pivot_df = filtered_df.pivot(index=country_col, columns=year_col, values=gdp_col)\n",
        "\n",
        "    fig = px.imshow(\n",
        "        pivot_df,\n",
        "        labels=dict(x=\"Year\", y=\"Country\", color=\"GDP (USD)\"),\n",
        "        color_continuous_scale=\"mint\",\n",
        "        title=\"US vs. China Over the Years\",\n",
        "    )\n",
        "\n",
        "    fig.update_layout(\n",
        "        height=700,\n",
        "        width=1200,\n",
        "        title_x=0.5,\n",
        "        title_xanchor='center'\n",
        "    )\n",
        "\n",
        "    fig.show()\n",
        "\n",
        "plot_gdp_heatmap_us_china(df)\n"
      ],
