        "# Bubble map\n",
        "\n",
        "import plotly.express as px\n",
        "\n",
        "def plot_gdp_bubble_map(df, year_col='Year', ISO_col='ISO Code', gdp_col='GDP (USD)', alliance_col='Alliances'):\n",
        "    fig = px.scatter_geo(\n",
        "        df,\n",
        "        locations=ISO_col,\n",
        "        size=gdp_col,\n",
        "        color=gdp_col,\n",
        "        hover_name=ISO_col,\n",
        "        hover_data=[gdp_col, alliance_col],\n",
        "        size_max=60,\n",
        "        color_continuous_scale=\"sunset\",\n",
        "        title=\"GDP by Country Over Years (Bubble Map)\",\n",
        "        labels={gdp_col: \"GDP (USD)\"},\n",
        "        animation_frame=year_col\n",
        "    )\n",
        "\n",
        "    fig.update_layout(\n",
        "        geo=dict(showcoastlines=True, coastlinecolor=\"Black\", projection_type=\"natural earth\"),\n",
        "        height=700,\n",
        "        width=1200,\n",
        "        title_x=0.5,\n",
        "        title_xanchor='center'\n",
        "    )\n",
        "\n",
        "    fig.show()\n",
        "\n",
        "plot_gdp_bubble_map(df)\n"
      ],
