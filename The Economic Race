        "import plotly.express as px\n",
        "\n",
        "def plot_gdp_by_country_animated(df, country_col='Country', gdp_col='GDP (USD)', alliance_col='Alliances', year_col='Year'):\n",
        "    # Create an animated bar chart\n",
        "    fig = px.bar(\n",
        "        df,\n",
        "        x=gdp_col,\n",
        "        y=country_col,\n",
        "        color=alliance_col,\n",
        "        animation_frame=year_col,\n",
        "        orientation='h',\n",
        "        title=\"The Economic Race by Country\",\n",
        "        color_discrete_map={'G7': 'red', 'BRICS': 'blue'},\n",
        "    )\n",
        "\n",
        "    # Customize layout\n",
        "    fig.update_layout(\n",
        "        xaxis=dict(title='GDP (USD)'),\n",
        "        yaxis=dict(title='Country', categoryorder='total ascending'),\n",
        "        template='plotly_white',\n",
        "        title_x=0.5,\n",
        "        title_xanchor='center',\n",
        "        height=700,\n",
        "        width=1000\n",
        "    )\n",
        "\n",
        "    fig.show()\n",
        "\n",
        "plot_gdp_by_country_animated(df)\n"
      ]
    },
